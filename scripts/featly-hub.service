[Unit]
Description=Featly Hub API
After=network.target

[Service]
Type=simple
User=featly
Group=featly
WorkingDirectory=/opt/featly/hub
Environment=PATH=/opt/featly/hub/venv/bin
# SQLite в системном каталоге /var/lib/featly-hub (создаётся systemd ДО namespace).
# Для PostgreSQL:
# Environment=FEATLY_DATABASE_URL=postgresql+asyncpg://featly:featly@localhost:5432/featly
Environment=FEATLY_DATABASE_URL=sqlite+aiosqlite:///var/lib/featly-hub/featly.db
Environment=FEATLY_WS_SECRET=change-me-in-production
# Каталоги, которые systemd создаёт сам (с правами featly) до настройки sandbox
StateDirectory=featly-hub
LogsDirectory=featly-hub
# Uploads — подкаталог StateDirectory (существует к моменту ExecStartPre)
ExecStartPre=-/usr/bin/install -d -o featly -g featly -m 0755 /var/lib/featly-hub/uploads
ExecStart=/opt/featly/hub/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=featly-hub

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/featly-hub /var/log/featly-hub

[Install]
WantedBy=multi-user.target