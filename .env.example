# ───────────── FEATLY v3 — пример конфигурации ─────────────
# Скопируйте в <.env> и заполните реальными значениями (или прокидывайте в окружение).
# Без задания этих ключей hub генерирует новые секреты при каждом старте
# (движок/плагин/панель потеряют доступ после рестарта).

# --- Hub (центр управления) ---
# SQLite — по умолчанию (легко, без контейнеров)
FEATLY_DATABASE_URL=sqlite+aiosqlite:///./featly.db
# PostgreSQL (опционально): postgresql+asyncpg://featly:featly@localhost:5432/featly
FEATLY_WS_SECRET=change-me-in-production
FEATLY_API_KEY=
FEATLY_COOKIE_KEY=
FEATLY_CORS_ORIGINS=["http://localhost:3000"]
FEATLY_UPLOAD_DIR=uploads

# Telegram (уведомления hub → TG, опционально)
FEATLY_TELEGRAM_BOT_TOKEN=
FEATLY_TELEGRAM_ALERT_CHAT_ID=

# --- Engine (Windows / Mini-ПК) — задаются на машине движка ---
FEATLY_WS_URL=ws://<vds-ip>:8000/ws/engine
FEATLY_BOT_ID=bot_main

# --- Admin (legacy/web-admin, только если поднимается) ---
# VITE_API_KEY=<тот же FEATLY_API_KEY>